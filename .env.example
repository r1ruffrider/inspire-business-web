# Names only. Never put a value here. Real values live in Vercel project settings (Production and
# Preview scopes) or in a local, untracked .env.local file.

# Secret. Server only. Resend API key (sending only, restricted to the sending domain).
# Production and Preview use SEPARATE keys. Leave unset locally when MAIL_TRANSPORT=log.
RESEND_API_KEY=

# Secret. Server only. Turnstile secret. Preview and local use Cloudflare's documented test secret.
TURNSTILE_SECRET_KEY=

# Public by design (bundled into the client). Turnstile site key.
VITE_TURNSTILE_SITE_KEY=

# Not secret. Display Name <address>. In production the address must be on send.inspirebusinesstechnology.com.
MAIL_FROM=

# Not secret. Exactly ONE recipient address. Preview defaults to a non-inbox test sink.
MAIL_TO=

# Not secret. Comma-separated full https origins. Required in production. Example shape only.
ALLOWED_ORIGINS=

# Local development only: set to "log" to print the composed email instead of sending it.
# Refused (every request returns 500) whenever VERCEL is set. Leave unset on Vercel.
MAIL_TRANSPORT=

# Preview only: set to 1 to let a preview deliver to the real company inbox. Leave unset otherwise.
PREVIEW_ALLOW_REAL_INBOX=
